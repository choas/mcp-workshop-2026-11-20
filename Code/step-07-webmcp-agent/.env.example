# Copy to .env and adjust. Read by the server only; the browser never sees keys.

# Which provider the page selects first: lmstudio | ollama | openai
LLM_PROVIDER=lmstudio

# LM Studio: Developer tab -> Start Server (or `lms server start`)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=
# LMSTUDIO_API_KEY=        # only if you turned on authentication in LM Studio

# Ollama: runs on port 11434 after install; pull a model with tool support first
OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=

# OpenAI, or any OpenAI-compatible endpoint (vLLM, OpenRouter, your company gateway, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# OPENAI_MODEL=            # a chat model with tool calling from your provider's /v1/models
